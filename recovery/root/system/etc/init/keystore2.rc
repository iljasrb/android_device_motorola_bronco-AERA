# Recovery keystore2 service (overrides system/core/rootdir/etc/init/keystore2.rc).
#
# AOSP starts keystore2 from late-init. In recovery that is too early to be
# useful and too late to be safe: qseecomd must have registered its TEE
# listeners first, while KeyMint is gated on crypto.ready from prepdecrypt.sh.
#
# qseecomd sets vendor.sys.listeners.registered once the TEE listeners are up.
# Start keystore2 from that, exactly like the gatekeeper HAL. It then blocks in
# AServiceManager_waitForService() until the AIDL KeyMint service appears and
# binds to it normally.
#
# Do NOT start keystore2 in the window after the keymint process starts but
# before it registers its AIDL service. It then takes the legacy HIDL keymaster
# fallback and rejects the hardware-wrapped metadata keyblob with
# INCOMPATIBLE_BLOCK_MODE, so /data never mounts and TWRP never shows the
# decryption prompt (#35).

on property:vendor.sys.listeners.registered=true
    start keystore2

service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    user root
    group keystore readproc log
    writepid /dev/cpuset/foreground/tasks
    seclabel u:r:recovery:s0
