# mount point        fstype  device                                          device2           flags
# Logical partitions
/system_ext          ext4    system_ext                                                        flags=display=System_EXT
/vendor_dlkm         ext4    vendor_dlkm                                                       flags=display=Vendor_DLKM

# Userdata / metadata
/metadata            ext4    /dev/block/bootdevice/by-name/metadata                            flags=display=Metadata

# Boot chain
/boot                emmc    /dev/block/bootdevice/by-name/boot                                flags=slotselect;display="Boot";backup=1;flashimg=1
/recovery            emmc    /dev/block/bootdevice/by-name/recovery                            flags=slotselect;display="Recovery";backup=1;flashimg=1
/vendor_boot         emmc    /dev/block/bootdevice/by-name/vendor_boot                         flags=slotselect;display="Vendor Boot";advbackup=1;flashimg=1
/dtbo                emmc    /dev/block/bootdevice/by-name/dtbo                                flags=slotselect;display="DTBO";backup=1;flashimg=1
/vbmeta              emmc    /dev/block/bootdevice/by-name/vbmeta                              flags=slotselect;display="VBMeta";advbackup=1;flashimg=1
/vbmeta_system       emmc    /dev/block/bootdevice/by-name/vbmeta_system                       flags=slotselect;display="VBMeta System";advbackup=1;flashimg=1

# Persistent firmware and properties
/firmware            vfat    /dev/block/bootdevice/by-name/modem                               flags=slotselect;display="Firmware";fsflags="ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0"
/persist             ext4    /dev/block/bootdevice/by-name/persist                             flags=display="Persist";fsflags=ro
/persist_image       emmc    /dev/block/bootdevice/by-name/persist                             flags=display="Persist";backup=1

# Modem
/modem               emmc    /dev/block/bootdevice/by-name/modem                               flags=slotselect;backup=1;display="Modem"
/dsp                 emmc    /dev/block/bootdevice/by-name/dsp                                 flags=slotselect;backup=1;subpartitionof=/modem

# EFS
/efs1                emmc    /dev/block/bootdevice/by-name/modemst1                            flags=slotselect;advbackup=1;display="EFS"
/efs2                emmc    /dev/block/bootdevice/by-name/modemst2                            flags=slotselect;backup=1;subpartitionof=/efs1
/efsc                emmc    /dev/block/bootdevice/by-name/fsc                                 flags=slotselect;backup=1;subpartitionof=/efs1
/efsg                emmc    /dev/block/bootdevice/by-name/fsg                                 flags=slotselect;backup=1;subpartitionof=/efs1

# Internal storage
/storage             f2fs    /data/media/0                                                     flags=display="Internal Storage";usermrf;backup=1;fsflags="bind";removable

# Removable storage
/usb_otg             vfat    /dev/block/sdg1                                  /dev/block/sdg    flags=fsflags=utf8;display="USB Storage";storage;wipeingui;removable
