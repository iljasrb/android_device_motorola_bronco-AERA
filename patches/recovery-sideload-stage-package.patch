+    // installer, host sees "adb: failed to read command"). Stream the package
+    // into tmpfs once and install from there.
+    std::string package_path = FUSE_SIDELOAD_HOST_PATHNAME;
+    constexpr const char* kLocalPackage = "/tmp/sideload_package.zip";
