@@ -141,6 +141,33 @@ static bool WriteStatusToFd(MinadbdCommandStatus status, int fd) {
   return true;
 }
 
+static bool StageSideloadPackage(const char* source, const char* destination) {
+  android::base::unique_fd in(open(source, O_RDONLY | O_CLOEXEC));
+  if (in < 0) {
+    PLOG(ERROR) << "Could not open the sideload package";
+    return false;
+  }
+  android::base::unique_fd out(
+      open(destination, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0600));
+  if (out < 0) {
+    PLOG(ERROR) << "Could not create the staged sideload package";
+    return false;
+  }
+  std::vector<char> buffer(65536);
+  ssize_t count;
+  while ((count = TEMP_FAILURE_RETRY(read(in.get(), buffer.data(), buffer.size()))) > 0) {
+    if (!android::base::WriteFully(out.get(), buffer.data(), count)) {
+      PLOG(ERROR) << "Could not write the staged sideload package";
+      return false;
+    }
+  }
+  if (count < 0) {
+    PLOG(ERROR) << "Could not read the sideload package";
+    return false;
+  }
+  return true;
+}
