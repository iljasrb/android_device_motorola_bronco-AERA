diff --git a/aeraui/core/runner.cpp b/aeraui/core/runner.cpp
index 5e55427..b98f340 100644
--- a/aeraui/core/runner.cpp
+++ b/aeraui/core/runner.cpp
@@ -301,8 +301,19 @@ bool HandleEvent(Engine& engine, InteractionBoost& performance,
             pointer.y=event.value&0xffff;
             pointer.slot=event.code>=2?1:0;
             pointer.pressed=event.code==1||event.code==3;
-            engine.SetAmbientFingerprintPointer(pointer);
-            return false;
+            // The ambient lock owns touches on its fingerprint target. Only a
+            // contact it did not consume is a wake gesture.
+            if (engine.SetAmbientFingerprintPointer(pointer)) return false;
+            // A touch is a wake gesture: without this the display only woke on
+            // a hardware key, so the screen looked dead to touch.
+            if (!engine.WakeForOperation()) {
+                engine.ShowLockScreen();
+                engine.SetSuspended(false);
+            }
+            aeraScreenTimer.Wake();
+            performance.Boost();
+            hardware.screen_off = false;
+            return false;  // swallow the waking contact
         }
         performance.Boost();
         aeraScreenTimer.Wake();
