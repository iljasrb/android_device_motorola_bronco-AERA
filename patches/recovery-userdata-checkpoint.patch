diff --git a/partition.cpp b/partition.cpp
index 332ead03..f4d805b0 100644
--- a/partition.cpp
+++ b/partition.cpp
@@ -1798,6 +1798,21 @@ bool TWPartition::Mount(bool Display_Error) {
 	}
 
 exit:
+	// make_f2fs leaves userdata checkpoint-disabled; while that flag is set the
+	// kernel rolls back to an old checkpoint, so recovery shows stale content and
+	// loses its own writes on the next boot. Mount() is polled, and a remount is
+	// a full f2fs mount, so try once per process and only while it is disabled.
+	if (Mount_Point == "/data" && Current_File_System == "f2fs") {
+		static bool checkpoint_checked = false;
+		if (!checkpoint_checked) {
+			std::string mounts;
+			if (TWFunc::read_file("/proc/mounts", mounts) == 0) {
+				checkpoint_checked = true;
+				if (mounts.find("checkpoint=disable") != std::string::npos)
+					TWFunc::Exec_Cmd("mount -o remount,checkpoint=enable /data");
+			}
+		}
+	}
 	if (Removable)
 		Update_Size(Display_Error);
 
