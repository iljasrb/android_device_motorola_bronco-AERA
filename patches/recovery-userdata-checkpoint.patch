 RunResult RunAeraUi(const DisplayMetrics& metrics) {
+    // One-shot, off the UI thread: a checkpoint-disabled userdata rolls back to
+    // an old checkpoint, losing recovery's own writes (settings, backups).
+    // Waits for the storage mount, then remounts with checkpoints enabled.
+    std::thread([] {
+        for (int attempt = 0; attempt < 40; ++attempt) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(500));
+            std::string mounts;
+            if (TWFunc::read_file("/proc/mounts", mounts) != 0) continue;
+            if (mounts.find(" /data f2fs ") == std::string::npos) continue;
+            if (mounts.find("checkpoint=disable") == std::string::npos) break;
+            TWFunc::Exec_Cmd("mount -o remount,checkpoint=enable /data");
+            break;
+        }
+    }).detach();
+
     std::thread early_thread;
     bool run_inline = false;
