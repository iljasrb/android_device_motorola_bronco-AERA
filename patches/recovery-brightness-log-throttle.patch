diff --git a/twrp-functions.cpp b/twrp-functions.cpp
index 0213848b..bb429970 100755
--- a/twrp-functions.cpp
+++ b/twrp-functions.cpp
@@ -2112,8 +2112,15 @@ int TWFunc::Set_Brightness(std::string brightness_value)
 
   if (DataManager::GetIntValue("tw_has_brightnesss_file"))
     {
-      LOGINFO("TWFunc::Set_Brightness: Setting brightness control to %s\n",
-	      brightness_value.c_str());
+      // Fades call this per frame; log only when the value actually moves a
+      // visible step, otherwise the log grows by thousands of lines per fade.
+      static int last_logged = -1;
+      int current_value = atoi(brightness_value.c_str());
+      if (last_logged < 0 || abs(current_value - last_logged) >= 64) {
+        last_logged = current_value;
+        LOGINFO("TWFunc::Set_Brightness: Setting brightness control to %s\n",
+	        brightness_value.c_str());
+      }
       result =
 	TWFunc::write_to_file(DataManager::GetStrValue("tw_brightness_file"),
 			      brightness_value);
