diff --git a/etc/init.rc b/etc/init.rc
index 96e0a078..2a1a97d8 100644
--- a/etc/init.rc
+++ b/etc/init.rc
@@ -131,8 +131,11 @@ service console /system/bin/sh
 on init && property:ro.debuggable=1
