--- a/aeraui/platform/aera_backend.cpp
+++ b/aeraui/platform/aera_backend.cpp
@@ -55,7 +55,9 @@
 
 #include <cutils/properties.h>
 #include <private/android_filesystem_config.h>
+#include <android-base/file.h>
 #include <android-base/properties.h>
+#include <android-base/strings.h>
 
 #include "data.hpp"
 #include "aera_flash_log.hpp"
@@ -2006,8 +2037,59 @@ static int RecoveryRunJobImpl(const JobRequest &request) {
       property_set("sys.usb.config", "none");
       usleep(300000);
     }
+    // The crypto consumers chdir into /data (gatekeeperd ->
+    // /data/misc/gatekeeper, keystore2 -> /data/misc/keystore) and keep it busy,
+    // so Format_Data cannot replace the filesystem ("Error: In use by the
+    // system!" from mkfs.f2fs). Stop them and detach /data first.
+    for (const char *service : {"gatekeeperd", "keystore2"}) {
+      if (android::base::GetProperty(std::string("init.svc.") + service, "") ==
+          "running") {
+        property_set("ctl.stop", service);
+      }
+    }
+    // TWRP's Format_Data unmaps every dynamic partition first and aborts with
+    // "Unable to unmap dynamic partitions" while any dm-backed mount is busy
+    // (recovery itself maps /vendor libraries). Detach those mounts lazily: the
+    // holders keep their inodes, but the mount no longer blocks the unmap.
+    {
+      std::string mounts;
+      if (android::base::ReadFileToString("/proc/mounts", &mounts)) {
+        for (const auto &line : android::base::Split(mounts, "\n")) {
+          const auto fields = android::base::Split(line, " ");
+          if (fields.size() < 2) continue;
+          if (fields[0].compare(0, 15, "/dev/block/dm-") != 0) continue;
+          if (fields[1] == "/data") continue;
+          if (umount2(fields[1].c_str(), MNT_DETACH) == 0)
+            LOGINFO("AERA format: detached dynamic mount %s\n", fields[1].c_str());
+        }
+      }
+    }
+    for (int attempt = 0; attempt < 25; ++attempt) {
+      if (!PartitionManager.Is_Mounted_By_Path("/data")) break;
+      PartitionManager.UnMount_By_Path("/data", true);
+      usleep(200000);
+    }
+    if (PartitionManager.Is_Mounted_By_Path("/data")) umount2("/data", MNT_DETACH);
+
+    // Metadata encryption keeps userdata mapped through dm-default-key, and the
+    // kernel holds that mapping open, so mkfs.f2fs cannot take the partition
+    // exclusively ("Error: In use by the system!") and the mapping cannot be
+    // removed. Format_Data() therefore only succeeds when the map is already
+    // gone; otherwise the format is marked pending and recovery restarts and
+    // formats userdata before the crypto chain maps it again.
+    TWFunc::Exec_Cmd("dmsetup remove userdata");
     TWFunc::SetPerformanceMode(true);
-    const int result = PartitionManager.Format_Data() ? 0 : 1;
+    int result = PartitionManager.Format_Data() ? 0 : 1;
+    if (result != 0) {
+      LOGINFO("AERA format: crypto mapping still held, deferring to restart\n");
+      if (TWFunc::Exec_Cmd("/system/bin/aera-format-pending.sh mark") == 0) {
+        result = 0;
+        TWFunc::SetPerformanceMode(false);
+        gui_msg(Msg("aera_format_restart=Formatting data, recovery will restart."));
+        property_set("sys.powerctl", "reboot,recovery");
+        return 0;
+      }
+    }
     PartitionManager.Update_System_Details();
     TWFunc::SetPerformanceMode(false);
     if (restore_fastboot) property_set("sys.usb.config", "fastboot");
@@ -3394,6 +3480,16 @@ bool WriteFileAtomically(const std::string& path, const std::string& contents) {
     unlink(temporary.c_str());
     return false;
   }
+  // The rename lives in the parent directory: fsync it so the new entry is on
+  // disk before a reboot, and push a checkpoint for the whole filesystem.
+  const auto slash = path.find_last_of('/');
+  const std::string parent = slash == std::string::npos ? "." : path.substr(0, slash);
+  const int dir = open(parent.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+  if (dir >= 0) {
+    fsync(dir);
+    syncfs(dir);
+    close(dir);
+  }
   chmod(path.c_str(), 0600);
   aera::shared_storage::Normalize(path);
   return true;
